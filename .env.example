# DATABASE_URL / POSTGRES_URL: Connection string for Neon PostgreSQL database on Vercel
# Vercel automatically injects this when you attach a Neon database integration
DATABASE_URL=
POSTGRES_URL=

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key for signing and verifying JSON Web Tokens
JWT_SECRET="delegatex_super_secret_jwt_key_2026_un_diplomacy"

# SMTP / Gmail Dispatch Configuration for Verification Codes
# Configure with your Gmail (e.g. delegatex14@gmail.com and 16-character Google App Password) or any SMTP server
GMAIL_USER=delegatex14@gmail.com
GMAIL_APP_PASSWORD=coaw oxux lwrx etko
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="DelegateX Security <delegatex14@gmail.com>"
